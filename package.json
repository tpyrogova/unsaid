{
  "name": "unsaid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run prompts && mkdir -p dist && wrangler pages dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply unsaid --local",
    "build": "npm run prompts && tsc -b && vite build",
    "typecheck": "npm run prompts && tsc -b",
    "test": "npm run prompts && vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "prompts": "node scripts/build-prompts.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
